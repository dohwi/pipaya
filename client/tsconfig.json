{
	"extends": "@tsconfig/svelte/tsconfig.json",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["svelte", "vite/client"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"paths": {
			"@shared/*": ["../server/src/shared/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "src/**/*.svelte.ts", "../server/src/shared/**/*.ts"]
}
