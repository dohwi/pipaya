{
  "manifest": {
    "id": "lang.ja",
    "name": "日本語 language pack",
    "version": "1.0.0",
    "sdkVersion": 1,
    "description": "Adds Japanese to the language list (starter pack)",
    "permissions": [
      "locales"
    ]
  },
  "locales": [
    {
      "tag": "ja",
      "name": "日本語",
      "messages": {
        "설정": "設定",
        "닫기": "閉じる",
        "저장": "保存",
        "취소": "キャンセル",
        "삭제": "削除",
        "새 대화": "新しいチャット",
        "대화 검색": "チャットを検索",
        "언어": "言語",
        "테마": "テーマ",
        "시스템": "システム",
        "라이트": "ライト",
        "다크": "ダーク",
        "일반": "一般",
        "단축키": "ショートカット",
        "서버": "サーバー",
        "확장": "拡張機能",
        "백업": "バックアップ",
        "보내기": "送信",
        "중지": "停止",
        "복사": "コピー",
        "복사됨": "コピーしました",
        "다시 시도": "再試行",
        "승인": "承認",
        "거부": "拒否",
        "무엇을 함께 작업할까요?": "何を一緒に作業しますか?",
        "모델 {n}개": "{n}個のモデル",
        "대화 {n}개": "{n}件のチャット"
      }
    }
  ]
}
