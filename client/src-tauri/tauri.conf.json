{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pipaya",
  "version": "0.3.7",
  "identifier": "work.pipaya.app",
  "build": {
    "beforeDevCommand": "bun scripts/prepare-desktop.ts && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun scripts/prepare-desktop.ts && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "pipaya",
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-eval' blob: 'sha256-KR08wn5R4dfQz4ffaPjKeIWQ+A+i3iDEgUbX1d4L7dk='",
        "worker-src": "blob:",
        "connect-src": "'self' ipc: http://ipc.localhost http: https: ws: wss:",
        "img-src": "'self' data: blob: http: https: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "style-src-attr": "'unsafe-inline'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "media-src": "'self' blob:",
        "frame-src": "blob: data:"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' blob:",
        "worker-src": "blob:",
        "connect-src": "'self' ipc: http://ipc.localhost http: https: ws: wss:",
        "img-src": "'self' data: blob: http: https: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "style-src-attr": "'unsafe-inline'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "media-src": "'self' blob:",
        "frame-src": "blob: data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.macos.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBREEzMzdGRjlCQUFCQzIKUldUQ3E3cjVmelBhcW9ZMDlNOEdjczRmWm1adzRhUWZSb2Q2OUVUcit5d1piWDBGYVA5ZC9lVGQK",
      "endpoints": [
        "https://github.com/dohwi/pipaya/releases/download/latest/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "pipaya"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "pipaya"
          ],
          "host": "connect",
          "appLink": false
        }
      ]
    }
  }
}
