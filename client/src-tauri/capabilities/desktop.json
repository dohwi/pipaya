{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-updater",
  "description": "Self-update, desktop only",
  "windows": [
    "main"
  ],
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "permissions": [
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "updater:default",
    "process:allow-restart"
  ]
}
