{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "os:default",
    "os:allow-hostname",
    "opener:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    "notification:default",
    "pipaya-push:default",
    "deep-link:default"
  ]
}
