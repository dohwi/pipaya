<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The server URL is user-configured and may be a Tailscale HTTP endpoint.
         Prefer HTTPS outside trusted networks; revisit for App Store review. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
        <key>NSAllowsArbitraryLoadsInWebContent</key>
        <true/>
    </dict>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Connect to your pipaya server on your local or Tailscale network.</string>
</dict>
</plist>
